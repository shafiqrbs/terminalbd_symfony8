{% extends '::base-report.html.twig' %}
{% block body %}
    <div id="print-area">
        <div class="row print-header">
            <div class="col-md-4"></div>
            <div class="col-md-4 text-center">
                <p><strong>{{ option.name }}</strong></p>
                <p><strong>Name of Report: System Overview</strong></p>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered table-striped table-condensed flip-content ">
                    <thead class="flip-content ">
                    <tr class="head-red">
                        <th class="" colspan="2">Current Capital</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set payable = (accountPurchase.purchaseAmount - accountPurchase.payment) %}
                    {% set receivable = (accountSales.totalAmount - accountSales.receiveAmount) %}
                    <tr><td class="numeric" >Cash in hand</td><td>{{ ((transactionCashOverviews['openingBalance']+transactionCashOverviews['debit']) - transactionCashOverviews['credit'])|number_format }}</td></tr>
                    <tr><td class="numeric" >Stock Purchase Price</td><td>{{ currentStockPrice.purchasePrice|number_format }}</td></tr>
                    <tr><td class="numeric" >Sales Receivable Amount</td><td>{{ (receivable)|number_format }}</td></tr>
                    <tr><td class="numeric" >Purchase Payable Amount</td><td>({{ payable|number_format }})</td></tr>
                    <tr><th class="numeric" >Capital</th><th>{{ ((currentStockPrice.purchasePrice + receivable + ((transactionCashOverviews['openingBalance']+transactionCashOverviews['debit']) - transactionCashOverviews['credit']))-payable)|number_format }}</th></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <br/>
        <br/>
        <div class="row">
            <div class="col-md-6">
                <table class="table table-bordered table-striped table-condensed flip-content ">
                    <thead class="flip-content ">
                    <tr class="head-blue">
                        <th class="" colspan="2">Current Stock & Price </th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td class="numeric" >Approximately Sales Price</td>
                        <td class="numeric" >{{ currentStockPrice.salesPrice|number_format }}</td>
                    </tr>
                    <tr>
                        <td class="numeric" >Purchase Price</td>
                        <td class="numeric" >{{ currentStockPrice.purchasePrice|number_format }}</td>
                    </tr>
                    <tr>
                        <td class="numeric" >Approximately Profit</td>
                        <td class="numeric" >{{ (currentStockPrice.salesPrice - currentStockPrice.purchasePrice)|number_format }}</td>
                    </tr>
                    <tr>
                        <td class="numeric" >&nbsp;</td>
                        <td class="numeric" >&nbsp;</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-6">
                <table class="table table-bordered table-striped table-condensed flip-content ">
                    <thead class="flip-content ">
                    <tr class="head-green">
                        <th class="" colspan="2">Current Stock & Price </th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set totalExpense = 0 %}
                    {% for expense in income.expenditures %}
                        {% set totalExpense = totalExpense + expense.amount  %}
                    {% endfor %}
                    <tr><td class="numeric" >Total Sales</td><td>{{ income.sales|number_format }}</td></tr>
                    <tr><td class="numeric" >Purchase Price</td><td>{{ income.purchase|number_format }}</td></tr>
                    <tr><td class="numeric" >Expenditure</td><td>{{ totalExpense|number_format }}</td></tr>
                    <tr><td class="numeric" >NET INCOME</td><td>{{ (income.sales - (income.purchase + totalExpense ))|number_format }}</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <br/>
        <br/>
        <div class="row">
            <div class="col-md-12">
                <div class="row-fluid">
                    <div class="col-md-6">
                        <table class="table table-bordered table-striped table-condensed flip-content ">
                            <thead class="flip-content ">
                            <tr class="head-yellow">
                                <th class="" colspan="2">Purchase Overview </th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr><td class="numeric" >Purchase BDT</td><td>{{ accountPurchase.purchaseAmount|number_format }}</td></tr>
                            <tr><td class="numeric" >Payment BDT</td><td>{{ accountPurchase.payment|number_format }}</td></tr>
                            <tr><td class="numeric" >Due BDT</td><td>{{ (accountPurchase.purchaseAmount - accountPurchase.payment)|number_format }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-bordered table-striped table-condensed flip-content ">
                            <thead class="flip-content ">
                            <tr class="head-gray">
                                <th class="" colspan="2">Sales Overview </th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr><td class="numeric" >Sales BDT</td><td>{{ accountSales.totalAmount|number_format }}</td></tr>
                            <tr><td class="numeric" >Receive BDT</td><td>{{ accountSales.receiveAmount|number_format }}</td></tr>
                            <tr><td class="numeric" >Due BDT</td><td>{{ (accountSales.totalAmount - accountSales.receiveAmount)|number_format }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <br/>
        <br/>
        <div class="row">
            <div class="col-md-12">
        <table class="table table-bordered table-striped table-condensed flip-content ">
            <thead class="flip-content">
            <tr class="head-feroza">
                <th class="numeric" ><strong>Received Mode</strong></th>
                <th class="numeric" ><strong>Count</strong></th>
                <th class="numeric" ><strong>Total</strong></th>
                <th class="numeric" ><strong>Received</strong></th>
                <th class="numeric" ><strong>Balance</strong></th>
            </tr>
            </thead>
            <tbody>
            {% set countInvoice = 0 %}
            {% set netTotal = 0 %}
            {% set netReceive = 0 %}
            {% for overview in overview %}
                {% set countInvoice = countInvoice + overview.totalCount  %}
                {% set netTotal = netTotal+ overview.total  %}
                {% set netReceive = netReceive+ overview.receive  %}
                <tr>
                    <td class="numeric" ><strong>{{ overview.processHead|capitalize }}</strong></td>
                    <td class="numeric" ><strong>{{ overview.totalCount }}</strong></td>
                    <td class="numeric" ><strong>{{ overview.total|number_format }}</strong></td>
                    <td class="numeric" ><strong>{{ overview.receive|number_format }}</strong></td>
                    <td class="numeric" ><strong>{% if overview.total > 0  %}{{ (overview.total-overview.receive)|number_format }}{% endif %}</strong></td>
                </tr>
            {% endfor %}
            </tbody>
            <tr><th>Summary</th><th>{{ countInvoice }}</th><th>{{ netTotal|number_format }}</th><th>{{ netReceive|number_format }}</th><th>{{ (netTotal-netReceive)|number_format }}</th></tr>
        </table>
            </div>
        </div>
        <br/>
        <br/>
        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered table-striped table-condensed flip-content ">
                    <thead class="flip-content">
                    <tr class="head-purple">
                        <th class="numeric" ><strong>Payment Mode</strong></th>
                        <th class="numeric" ><strong>Count</strong></th>
                        <th class="numeric" ><strong>Total</strong></th>
                        <th class="numeric" ><strong>Payment</strong></th>
                        <th class="numeric" ><strong>Balance</strong></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set countInvoice = 0 %}
                    {% set netTotal = 0 %}
                    {% set netReceive = 0 %}
                    {% for overview in accountPaymentOverview %}
                        {% set countInvoice = countInvoice + overview.totalCount  %}
                        {% set netTotal = netTotal+ overview.total  %}
                        {% set netReceive = netReceive+ overview.receive  %}
                        <tr>
                            <td class="numeric" ><strong>{{ overview.processHead|capitalize }}</strong></td>
                            <td class="numeric" ><strong>{{ overview.totalCount }}</strong></td>
                            <td class="numeric" ><strong>{{ overview.total|number_format }}</strong></td>
                            <td class="numeric" ><strong>{{ overview.receive|number_format }}</strong></td>
                            <td class="numeric" ><strong>{% if overview.total > 0  %}{{ (overview.total-overview.receive)|number_format }}{% endif %}</strong></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tr><th>Summary</th><th>{{ countInvoice }}</th><th>{{ netTotal|number_format }}</th><th>{{ netReceive|number_format }}</th><th>{{ (netTotal-netReceive)|number_format }}</th></tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

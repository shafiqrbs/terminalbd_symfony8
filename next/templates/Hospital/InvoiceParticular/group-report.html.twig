        $('#clone-block').on('click', '.remove', function(){
        $(this).closest('.clone').remove();
    });

    $('.trash').on("click", ".remove", function() {

        var url = $(this).attr('data-url');
        var id = $(this).attr("id");
        $.ajax({
        url: url,
        type: 'GET',
        success: function (response) {
        if ('success' == response) {
            location.reload();
        }
        },
        })
    })

    $('#invoiceParticular').on("change", ".input-select", function() {

        var url = $(this).attr('data-url');

{% extends '::base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <!-- BEGIN category HEADER-->
        <div class="row-fluid">
            <div class="span12">
                <h3 class="category-title">
                    Manage Diagnostic Report Prepared
                </h3>
                <ul class="breadcrumb">
                    <li>
                        <i class="icon-home"></i>
                        <a href="{{ path('homepage') }}">Home</a>
                        <span class="icon-angle-right"></span>
                    </li>
                    <li><a href="#">Manage Diagnostic Report Prepared</a></li>
                    <li class="pull-right btn blue disabled mini">
                        <i class="fa fa-calendar"></i>
                        {{ "now"|date("d-F-Y") }}
                    </li>
                </ul>
            </div>
        </div>
        <!-- END category HEADER-->
        <!-- BEGIN category CONTENT-->
        {{ form_start(form) }}
        {{ form_row(form._token) }}
        <div class="row-fluid">
            <div class="span12">
                <div class="portlet box green tabbable">
                <div class="portlet-title">
                    <div class="caption"><i class="icon-reorder"></i>Diagnostic Report Prepared : </div>
                </div>
                <div class="portlet-body">
                <div class="portlet-body form">
                    <div class="row-fluid">
                        <div class="span4">
                            <h4>About:</h4>
                            <ul class="unstyled">
                                {% if invoice.customer is not empty %}<li><strong>Customer #:</strong>&nbsp;{{ invoice.customer.name }}</li>{% endif %}
                                {% if invoice.customer is not empty %}<li><strong>Mobile #:</strong>&nbsp;{{ invoice.customer.mobile }}</li>{% endif %}
                                {% if invoice.customer is not empty and invoice.customer.location is not empty   %}<li><strong>Location #:</strong>&nbsp;{{ invoice.customer.location.name }}, {{ invoice.customer.location.parent.name }}</li>{% endif %}
                            </ul>
                        </div>
                        <div class="span4">
                            <h4>Payment Method:</h4>
                            <ul class="unstyled">
                                <li><strong>Created:</strong>&nbsp;{{ invoice.created|date('d-m-Y') }}</li>
                                <li><strong>Delivery:</strong>&nbsp;{{ invoice.deliveryDate }}</li>
                                <li><strong>Payment Method:</strong>&nbsp;{{ invoice.paymentMethod }}</li>
                                <li><strong>Received By:</strong>&nbsp;{% if invoice.createdBy is defined and invoice.createdBy is not empty %}{{ invoice.createdBy }}{% endif %}</li>
                                <li><strong>Delivery Status:</strong>&nbsp;{{ invoice.process|capitalize }}</li>
                            </ul>
                        </div>
                        <div class="span4">
                            <h4>Referred By:</h4>
                            {% if invoice.referredDoctor is not empty %}
                                <ul class="unstyled">
                                    <li><strong>Code:</strong>&nbsp;{{ invoice.referredDoctor.particularCode }}</li>
                                    <li><strong>Name:</strong>&nbsp;{{ invoice.referredDoctor.name }}</li>
                                    <li><strong>Mobile:</strong>&nbsp;{{ invoice.referredDoctor.mobile }}</li>
                                    <li><strong>Address:</strong>&nbsp;{{ invoice.referredDoctor.address }}</li>
                                </ul>
                            {% endif %}
                        </div>
                    </div>
                    {% for pathology in pathologies %}
                        <div class="form-actions portlet box blue">
                            <div class="portlet-title">
                                <div class="caption"><i class="icon-reorder"></i>Report Format {{ pathology.particular.name }}</div>
                            </div>
                        </div>
                        <div class="clearfix">&nbsp;</div>
                        <div class="row-fluid box green">
                            <table class="table table-bordered table-striped table-condensed flip-content ">
                                <thead class="flip-content ">
                                    <tr class="head-red">
                                        <th class="numeric span5">Name</th>
                                        <th class="numeric span2">Result</th>
                                        <th class="numeric span2">Unit</th>
                                        <th class="numeric span3">Reference</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% if pathology.particular.service.slug == 'diagnostic' %}
                                {% for item in pathology.particular.pathologicalReports %}
                                    {% if item.children is not empty %}
                                        <tr id="remove-{{ item.id }}">
                                            <td  class="numeric" colspan="5"><strong>{{ item.name }}</strong></td>
                                        </tr>
                                        {% for child in item.children %}
                                            <tr id="remove-{{ item.id }}">
                                                <td  class="numeric">{{ child.name }}</td>
                                                <td class=""><input type="text" id="result-{{ item.id }}" name="result-{{ item.id }}" data-url="{{ path('hms_invoice_group_pathological_report_update',{'id':report[child.id].id}) }}" class="m-wrap span12 input-select" data-index="{{ child.id }}" value="{% if report is not empty and report[child.id] is defined and report[child.id] is not empty %}{{ report[child.id].result }} {% else %} {{ item.sampleValue }}{% endif %}"></td>
                                                <td class="numeric">{{ child.unit }}</td>
                                                <td class="numeric">{{ child.referenceValue }}</td>
                                                <input type="hidden" name="pathologicalReportId[]" value="{{ child.id }}" >
                                            </tr>
                                        {% endfor %}
                                    {% elseif item.parent is empty %}
                                        <tr id="remove-{{ item.id }}">
                                            <td  class="numeric">{{ item.name }}</td>
                                            <td class="">{% if item.children is empty %}<input type="text" name="result[]" data-url="{{ path('hms_invoice_group_pathological_report_update',{'id':report[item.id].id}) }}" class="m-wrap span12 input-select" data-index="{{ item.id }}" value="{% if report is not empty and report[item.id] is defined and report[item.id] is not empty %}{{ report[item.id].result }} {% else %} {{ item.sampleValue }}{% endif %}" >{% endif %}</td>
                                            <td class="numeric">{{ item.unit }}</td>
                                            <td class="numeric">{{ item.referenceValue }}</td>
                                            <input type="hidden" name="pathologicalReportId[]" value="{{ item.id }}" >
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                                {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% endfor %}
                    <div class="clearfix">&nbsp;</div>
                    <div class="form-actions portlet box blue">
                        <div class="portlet-title">
                            <div class="caption"><i class="icon-reorder"></i>Remark & Status</div>
                        </div>
                    </div>
                    <div class="clearfix">&nbsp;</div>
                    <div class="row-fluid">
                        <!--/span-->
                        <div class="span12">
                            <div class="control-group">
                                <label class="control-label" for="name">Report Head</label>
                                <div class="controls">
                                    {{ form_widget(form.category) }}
                                    {{ form_errors(form.category) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row-fluid">
                        <!--/span-->
                        <div class="span4">
                            <div class="control-group">
                                <label class="control-label" for="name">Assign Doctor </label>
                                <div class="controls">
                                    {{ form_widget(form.assignDoctor) }}
                                    {{ form_errors(form.assignDoctor) }}
                                </div>
                            </div>
                        </div>
                        <div class="span4">
                            <div class="control-group">
                                <label class="control-label" for="name">Assign Lab User </label>
                                <div class="controls">
                                    {{ form_widget(form.assignLabuser) }}
                                    {{ form_errors(form.assignLabuser) }}
                                </div>
                            </div>
                        </div>
                        <div class="span4">
                            <div class="control-group">
                                <label class="control-label" for="name">Process Progress </label>
                                <div class="controls">
                                    {{ form_widget(form.process) }}
                                    {{ form_errors(form.process) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row-fluid">
                        <!--/span-->
                        <div class="span12">
                            <div class="control-group">
                                <label class="control-label" for="name">Comment</label>
                                <div class="controls">
                                    {{ form_widget(form.comment) }}
                                    {{ form_errors(form.comment) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-actions portlet box grey">
                        <div class="pull-right">
                            {% if (app.user.granted("ROLE_DOMAIN_HOSPITAL_MANAGER") and entity.process == "Done") or (app.user.granted("ROLE_DOMAIN_HOSPITAL_LAB"))  %}
                                <button type="button" class="btn green confirmSubmit"><i class="icon-save"></i> Save</button>
                            {% endif %}
                            {% if (app.user.granted("ROLE_DOMAIN_HOSPITAL_REPORT_PRINT") and entity.process == "Done" ) %}
                                <a target="_blank" href="{{ path('hms_invoice_particular_report_print', {'id': entity.id}) }}"  class="btn blue"><i class="icon-print"></i> Print</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>
    <style>
        table.reportTable{
            width: 100%!important;
            collapse: 0;
            border-collapse: collapse;
            border: 2px solid #000000;
        }
        .note-editor .note-editing-area .note-editable table td, .note-editor .note-editing-area .note-editable table th {
            border: 2px solid #000000;
            padding: 5px 3px;
        }
        table.reportTable tr td , table.reportTable tr th{
            text-align: left;
            padding-left: 8px;
            border: 2px solid #000000;
        }
        table.reportTable tr:first-child td , table.reportTable tr:first-child th{
            font-weight: bold;
        }
        table.reportTable tr th.center, table.reportTable tr td.center{
            text-align: center;
        }
        table.reportTable tr td.left{
            text-align: left;
            padding-left: 8px;
        }
        table.reportTable tr td.right{
            text-align: right;
            padding-right: 15px;
        }
        table label{
            width: 72px;
            display: inline-block;
            text-decoration: none;
            font-size: 11px!important;
        }
    </style>
{% endblock %}
{% block javascriptBlock %}
    {{ parent() }}

    <script type="text/javascript" src="{{ asset('bundles/hospital/js/approveProcess.js') }}"></script>
    
{% endblock %}

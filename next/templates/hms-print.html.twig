<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>{% if app.user.globaloption is not empty and app.user.globaloption is defined %}{{ app.user.globaloption.name }}{% endif %} | ADMIN PANEL</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="" name="description"/>
    <meta content="" name="author"/>
    <link rel="shortcut icon" href="{{ asset('assets/img/favicon.ico') }}">
    <script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', {"callback": "fos.Router.setData"}) }}"></script>

    <link rel="stylesheet" href="{{ asset('assets/plugins/font-awesome/css/font-awesome.min.css') }}"/>
    
    <link rel="stylesheet" href="{{ asset('assets/css/print.css') }}"/>
    
    {% block cssBlock %}
    {% endblock %}
    <link rel="shortcut icon" href="favicon.ico"/>
</head>
<body>
<div class="page-container row-fluid">
    <div class="page-content">
        {% block body %}{% endblock %}
    </div>
    <div id="print-container" style="display:none"><div id="print-area"></div></div>
</div>
{#'http://bp.yahooapis.com/2.4.21/browserplus-min.js'#}
<script type="text/javascript">
        window.print();
        setTimeout(function () {
            window.open('', '_self', '');
            window.close();
        }, 2000);
</script>

<script type="text/javascript" src="{{ asset('assets/plugins/jquery-1.10.2.min.js') }}"></script>

<script type="text/javascript" src="{{ asset('assets/template/plugin/matchHeight/height-match.js') }}"></script>

<script type="text/javascript" src="{{ asset('assets/print/js/kinzi.print.min.js') }}"></script>

{% block javascriptBlock %}
{% endblock %}
<script type="text/javascript">
    jQuery(document).ready(function () {
        {% block documentready %}
        {% endblock %}
    });
 </script>
{% block footer %}
    <div class="footer">
        <div class="footer-inner">
            {{ "now"|date("Y") }} &copy; Created By Terminalbd.com.
        </div>
        <div class="footer-tools">
        <span class="go-top">
            <i class="fa fa-angle-up"></i>
        </span>
        </div>
    </div>
{% endblock footer %}
</body>
</html>

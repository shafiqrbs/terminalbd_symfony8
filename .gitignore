# Runtime tenant file cache, created by ToolManager::createMasterDirectory.
/public/cache/

# The Symfony 2.8 application's working state: vendor/, app/cache, app/logs,
# app/config/parameters.yml (real credentials) and web/'s compiled assets. The
# legacy application itself is no longer on this branch - it is on
# symfony8-migration and at the tag legacy-symfony2-final - but all of this is
# gitignored, so checking that branch out cannot restore any of it. Kept here
# under a name nothing collides with. To run the legacy application again:
#
#     git switch symfony8-migration
#     mv .legacy-runtime/app/cache .legacy-runtime/app/logs app/
#     mv .legacy-runtime/app/config/parameters.yml app/config/
#     mv .legacy-runtime/vendor .
#     php7.4 -S 127.0.0.1:8801 -t web migration/bin/serve-router.php
/.legacy-runtime/

# Database dumps - this is a multi-tenant medical/pharmacy SaaS, dumps carry
# patient and customer data and must never reach the repository.
*.sql
*.sql.gz
*.sql.bz2
*.dump
# The one exception, and it is not a dump: the seeded fixtures the verification
# harnesses need, which carry no tenant data at all - one InventoryConfig row of
# form-type defaults, so that phase 4's 42 screens can run against a dump that
# has no Inventory in it. Read terminalbd_api/docs/contract/inventory-module-screens.md
# before adding another; anything with a real row in it belongs above this line.
!migration/fixtures/*.sql

# Golden API capture: the overlay holds real credentials, and --with-body
# fixtures hold tenant rows. The shape-only fixtures are committed by hand.
/migration/capture-config.local.json
/migration/fixtures/*-with-body/
/migration/.capture-work/

# The phase 9 working captures. legacy/ and next/ are the committed contract, a
# pair taken from one database state; these two are re-taken together whenever
# the API is checked against the ported monolith, and would otherwise go stale
# the moment the scratch database changes.
/migration/fixtures/api/
/migration/fixtures/next-live/

# IDE
.idea/*
.nbproject/*

# OS
.DS_Store
Thumbs.db

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <title>{{ reportGroup.hmsInvoice.invoice }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="" name="description"/>
    <meta content="" name="author"/>
    <link rel="shortcut icon" href="{{ asset('assets/img/favicon.ico') }}">
    {% stylesheets filter='cssrewrite'
        'assets/plugins/font-awesome/css/font-awesome.min.css'
        'assets/css/print.css'
    %}
        <link rel="stylesheet" href="{{ asset_url }}"/>
    {% endstylesheets %}
    <script type="text/javascript">
        window.print();
        setTimeout(function () {
            window.open('', '_self', '');
            window.close();
        }, 2000);
    </script>
</head>
<body>
<div style="margin-top:{{  reportGroup.hmsInvoice.hospitalConfig.printMarginReportTop }}px;margin-left:{{ reportGroup.hmsInvoice.hospitalConfig.printMarginReportLeft }}px;">
    {%  if reportGroup.hmsInvoice.hospitalConfig.isPrintReportHeader == 1 %}
        <table class="table reportTable">
            <tr>
                <td>
                    <div class="span4 title-center text-center">
                        {%  if reportGroup.hmsInvoice.hospitalConfig.invoicePrintLogo == 1 %}
                            {% if reportGroup.hmsInvoice.hospitalConfig.globalOption.webPath('file') is not empty %}<img style="max-height:100px" src="/{{ reportGroup.hmsInvoice.hospitalConfig.globalOption.webPath('file')  }}">{% endif %}
                        {%  endif %}
                    </div>
                </td>
            </tr>
        </table>
    {% endif %}
    <table class="table table-border reportTable" style="border: 3px solid #383939!important" >
        <tr>
            <td style="width: 40%!important;">
                <ul class="unstyled">
                    <li><label>Invoice No:</label> {{ reportGroup.hmsInvoice.invoice }}</li>
                    <li><label>Patient Name:</label> {{ reportGroup.hmsInvoice.customer.name }}</li>
                    <li><label>Mobile:</label> {{ reportGroup.hmsInvoice.customer.mobile }}</li>
                    <li><label>Ref. By:</label> {% if reportGroup.assignDoctor is not empty %}<strong>{{ reportGroup.assignDoctor.name }}</strong>{% endif %}</li>
                </ul>
            </td>
            <td class="" style="width:25%!important;">
                <ul class="unstyled" >
                    <li><label>Age:</label> {{ reportGroup.hmsInvoice.customer.age }} {{ reportGroup.hmsInvoice.customer.ageType }}</li>
                    <li><label>Gender:</label> {{ reportGroup.hmsInvoice.customer.gender }} </li>
                    <li><label>Blood Group:</label> {{ reportGroup.hmsInvoice.customer.bloodGroup }} </li>
                    {% if reportGroup.hmsInvoice.cabin %}<li><label>Cabin/Bed No:</label>{{ reportGroup.hmsInvoice.cabin.name }} </li>{% endif %}
                </ul>
            </td>
            <td class="" style="width: 35%!important;">
                <ul class="unstyled">
                    <li><label>Report No:</label></li>
                    <li><label>Invoice Date:</label> {{ reportGroup.hmsInvoice.updated|date('d-m-y') }}</li>
                    <li><label>Delivery Date:</label> {{ reportGroup.hmsInvoice.deliveryDateTime }}</li>
                    <li><label>Coll. By:</label> {{ reportGroup.createdBy }}</li>
                </ul>
            </td>
        </tr>
    </table>
    {% if categories is not empty %}
        {% for item in categories %}
            <table class=" reportTable" style="margin-top:20px;">
                <caption><h4><strong>{{ item.name|capitalize }}</strong></h4></caption>
                <thead>
                <tr class="head-black">
                    <td class="span3">Name</td>
                    <td class="span1">Result</td>
                    <td class="span2">Unit</td>
                    <td class="span4">Reference</td>
                </tr>
                </thead>
                <tbody>
                {% if reports[item.id] is defined and reports[item.id] is not empty %}
                    {% for parent in reports[item.id] %}
                        <tr>
                            <td  class="span3"><strong>{{ parent.pathologicalReport.name }}</strong></td>
                            <td class="span2">{{ parent.result }}</td>
                            <td class="span2">{{ parent.pathologicalReport.unit }}</td>
                            <td class="span4">{{ parent.pathologicalReport.referenceValue|raw }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        {% endfor %}
    {% endif %}
    <table style="margin-top:20px;font-size:12px">
        <tr><td>Comment: {{ reportGroup.comment|raw }}</td></tr>
    </table>
    <table class="table print-footer">
        <tr>
            <td class="center span4">
                <ul class="unstyled">
                    <li>Printed By</li>
                    <li>{{ "now"|date('d-m-Y h:m') }}</li>
                </ul>
            </td>
            <td class="center span4">
                <ul class="unstyled">
                    <li>Prepared By</li>
                    <li><strong>{{ reportGroup.assignLabuser.name }}</strong></li>
                    <li><strong>{{ reportGroup.assignLabuser.doctorSignature }}</strong></li>
                </ul>
            </td>
            <td class="span4 center">
                {% if reportGroup.assignDoctor is not empty %}
                    <ul class="unstyled">
                        <li><strong>{{ reportGroup.assignDoctor.name }}</strong></li>
                        <li>{{ reportGroup.assignDoctor.educationalDegree|raw }}</li>
                        <li>{{ reportGroup.assignDoctor.specialist|raw }}</li>
                        {% if reportGroup.assignDoctor.category is not empty or reportGroup.assignDoctor.department is not empty %}<li> {% if reportGroup.assignDoctor.category is not empty %}{{ reportGroup.assignDoctor.category.name }}{% endif %} {% if reportGroup.assignDoctor.department is not empty %} ,{{ reportGroup.assignDoctor.department.name }}{% endif %}</li>{% endif %}
                        <li>{{ reportGroup.assignDoctor.designation }}</li>
                        <li>{{ reportGroup.assignDoctor.currentJob }}</li>
                    </ul>
                {% endif %}
            </td>
        </tr>
    </table>
</div>
</body>
<style>
    table.reportTable{
        width: 100%!important;
        collapse: 0;
        border-collapse: collapse;
        border: 1px solid #000000;
        font-size: 12px!important;
    }
    table.reportTable tr td , table.reportTable tr th{
        text-align: left;
        padding-left: 8px;
        border: 1px solid #000000;
        height: 24px;
        line-height: 24px;
        font-size: 12px!important;
    }
    table.reportTable tr:first-child th{
        font-weight: bold;
    }
    table.reportTable tr th.center, table.reportTable tr td.center{
        text-align: left;
        padding-left: 8px;
    }
    table.reportTable tr td.left{
        text-align: left;
        padding-left: 8px;
    }
    table.reportTable tr td.right{
        text-align: right;
        padding-right: 15px;
    }
    table label{
        width: 100px;
        display: inline-block;
        text-decoration: none;
    }
    .print-header {
        height: 50px;
        border: 1px solid #100f0f;
        font-size: 11px;
    }

    .print-header .title-center{
        float: none!important;
        text-align: center;
        text-transform: uppercase;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        position: absolute;
    }
    .print-header .barcode-left{
        float: left;
        padding-left: 10px;
    }
    .print-header .barcode-right{
        float: right;
        padding-right: 10px;
    }
    .print-footer .left{
        margin-left: 30px;
    }
    .print-footer .center{
        text-align: center;
    }
    .print-footer .right{
        float: right;
        padding-right:30px;
    }
    table.report-table {
        display:inline-block;
        width: 100%;
    {% if reportGroup.hmsInvoice.hospitalConfig.reportHeight  %}
        min-height:{{ reportGroup.hmsInvoice.hospitalConfig.reportHeight }}px;
    {% endif %}
    }
</style>
</html>

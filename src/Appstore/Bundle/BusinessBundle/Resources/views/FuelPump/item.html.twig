{% if entity %}
    {% for item in entity.businessBatchParticulars %}
        <tr>
            <td>{{ loop.index }}</td>
            <td>{{ item.salesBy.profile.name }}</td>
            <td>{{ item.wearhouse.name }}</td>
            <td>{{ item.businessParticular.name }}</td>
            <td>{{ item.startMeterReading }}</td>
            <td></td>
            <td>{{ item.price }}</td>
            <td>{{ item.quantity }}</td>
            <td>{{ item.quantity * item.price  }}</td>
            <td></td>
            <td></td>
            <td></td>
            <td>{{ item.process|capitalize }}</td>
            <td>
                <div class="btn-group">
                    {% if item.process !=  'Created' %}
                        <a data-id="{{ item.id }}" data-url="{{ path('business_fuelstation_item_delete', {'id': item.id }) }}" href="javascript:" class="btn red mini item-delete" data-trigger = "hover" data-original-title = "Delete" ><i class="icon-trash"></i> Delete</a>
                        <a data-id="{{ item.id }}" data-url="{{ path('business_fuelstation_item_approve', {'id': item.id }) }}" href="javascript:" class="btn blue mini approve"><i class="icon-refresh"></i> Approve</a>
                    {% endif %}
                </div>
            </td>
        </tr>
    {% endfor %}
{% endif %}